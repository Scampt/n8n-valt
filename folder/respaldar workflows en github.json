    {
      "id": "5dcc4351-3c94-410a-8bde-e93c10a127f5",
      "name": "isDiffOrNew",
      "parameters": {
        "jsCode": "// Función para ordenar llaves JSON de forma recursiva (deep sort)\nconst deepSortKeys = (obj) => {\n  if (Array.isArray(obj)) {\n    return obj.map(deepSortKeys);\n  }\n  if (obj !== null && typeof obj === 'object') {\n    const sorted = {};\n    Object.keys(obj).sort().forEach(key => {\n      sorted[key] = deepSortKeys(obj[key]);\n    });\n    return sorted;\n  }\n  return obj;\n};\n\n// Campos que cambian frecuentemente y no representan cambios reales\nconst fieldsToIgnore = ['updatedAt', 'triggerCount', 'shared', 'staticData', 'versionId'];\n\nconst stripVolatileFields = (obj) => {\n  const cleaned = { ...obj };\n  fieldsToIgnore.forEach(field => delete cleaned[field]);\n  return cleaned;\n};\n\n// Check if file returned with content\nif (Object.keys($input.all()[0].json).includes(\"content\") && $input.all()[0].json.content) {\n  // Decode base64 content and parse JSON\n  const origWorkflow = JSON.parse(Buffer.from($input.all()[0].json.content, 'base64').toString());\n  const n8nWorkflow = $input.all()[1].json;\n  \n  // Strip volatile fields and deep sort\n  const orderedOriginal = deepSortKeys(stripVolatileFields(origWorkflow));\n  const orderedActual = deepSortKeys(stripVolatileFields(n8nWorkflow));\n\n  // Determine difference\n  if (JSON.stringify(orderedOriginal) === JSON.stringify(orderedActual)) {\n    $input.all()[0].json.github_status = \"same\";\n  } else {\n    $input.all()[0].json.github_status = \"different\";\n    $input.all()[0].json.n8n_data_stringy = JSON.stringify(deepSortKeys(n8nWorkflow), null, 2);\n  }\n  $input.all()[0].json.content_decoded = orderedOriginal;\n\n// Check if file was fetched via download_url (data field)\n} else if (Object.keys($input.all()[0].json).includes(\"data\") && $input.all()[0].json.data) {\n  let origWorkflow;\n  try {\n    origWorkflow = typeof $input.all()[0].json.data === 'string' \n      ? JSON.parse($input.all()[0].json.data) \n      : $input.all()[0].json.data;\n  } catch(e) {\n    // If data can't be parsed, treat as new\n    const n8nWorkflow = $input.all()[1].json;\n    $input.all()[0].json.github_status = \"new\";\n    $input.all()[0].json.n8n_data_stringy = JSON.stringify(deepSortKeys(n8nWorkflow), null, 2);\n    return $input.all();\n  }\n  \n  const n8nWorkflow = $input.all()[1].json;\n  \n  const orderedOriginal = deepSortKeys(stripVolatileFields(origWorkflow));\n  const orderedActual = deepSortKeys(stripVolatileFields(n8nWorkflow));\n\n  if (JSON.stringify(orderedOriginal) === JSON.stringify(orderedActual)) {\n    $input.all()[0].json.github_status = \"same\";\n  } else {\n    $input.all()[0].json.github_status = \"different\";\n    $input.all()[0].json.n8n_data_stringy = JSON.stringify(deepSortKeys(n8nWorkflow), null, 2);\n  }\n  $input.all()[0].json.content_decoded = orderedOriginal;\n\n} else {\n  // No file found in GitHub → new workflow\n  const n8nWorkflow = $input.all()[1].json;\n  const orderedActual = deepSortKeys(n8nWorkflow);\n  \n  $input.all()[0].json.github_status = \"new\";\n  $input.all()[0].json.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n}\n\n// Return items\nreturn $input.all();\n"
      },
